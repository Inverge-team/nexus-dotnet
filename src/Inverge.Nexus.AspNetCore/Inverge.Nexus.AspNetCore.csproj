<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ASP.NET Core has not supported netstandard2.0 since 3.0, so this package
         is modern-only. The core SDK still reaches .NET Framework for apps that
         need it; they just wire the middleware up themselves. -->
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <AssemblyName>Inverge.Nexus.AspNetCore</AssemblyName>
    <RootNamespace>Inverge.Nexus.AspNetCore</RootNamespace>
    <PackageId>Inverge.Nexus.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for the Inverge Nexus SDK: middleware that binds the request's identity, route and device into the ambient telemetry context, and reports unhandled exceptions to Nexus error monitoring.</Description>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inverge.Nexus\Inverge.Nexus.csproj" />
    <ProjectReference Include="..\Inverge.Nexus.Extensions.Logging\Inverge.Nexus.Extensions.Logging.csproj" />
  </ItemGroup>

</Project>
